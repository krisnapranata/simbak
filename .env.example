# Salin ke .env lalu isi. File .env TIDAK di-commit.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=ganti-dengan-kunci-acak-panjang
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# MySQL/MariaDB:  mysql://user:pass@127.0.0.1:3306/simbak
# PostgreSQL:     postgres://user:pass@127.0.0.1:5432/simbak
# SQLite:         sqlite:///db.sqlite3
DATABASE_URL=mysql://user:pass@127.0.0.1:3306/simbak
TIME_ZONE=Asia/Makassar
MEDIA_PRIVATE_ROOT=media_private
UPLOAD_MAKS_MB=25
UNDUH_X_ACCEL=False
URL_DASAR=http://localhost:8000
# Email (kosongkan EMAIL_BACKEND untuk menampilkan email di konsol)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.rs.local
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=SIMBAK <simbak@rs.local>

# Salin ke .env.production lalu isi. JANGAN di-commit.
SECRET_KEY=ganti-dengan-string-acak-panjang
# Domain yang dipasang di Nginx Proxy Manager (tanpa https://), pisahkan koma bila lebih dari satu
ALLOWED_HOSTS=simbak.rs.example.id
CSRF_TRUSTED_ORIGINS=https://simbak.rs.example.id
URL_DASAR=https://simbak.rs.example.id
# Password HARUS sama dengan MARIADB_PASSWORD di .env.db. Gunakan huruf/angka saja
# (karakter khusus seperti @ : / # harus di-URL-encode).
DATABASE_URL=mysql://simbak:GANTI_PASSWORD_DB@db:3306/simbak
TIME_ZONE=Asia/Makassar
UPLOAD_MAKS_MB=25
UNDUH_X_ACCEL=True

# Penjadwal pengingat harian (container simbak_jadwal)
JAM_PENGINGAT=06:00
GUNICORN_WORKERS=3

# HTTPS diterminasi Nginx Proxy Manager. Set False HANYA untuk uji coba lewat http://IP:8030
SECURE_SSL_REDIRECT=True
COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# Email (opsional). Kosongkan EMAIL_BACKEND untuk menonaktifkan pengiriman (tampil di log).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.rs.example.id
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=SIMBAK <simbak@rs.example.id>
